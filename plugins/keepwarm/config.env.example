# Copy to ~/.claude/keepwarm/config.env and edit. Values here override the
# environment, because a background session's monitor never sees your shell.

# Bump once the session has been idle this long. Keep it under the cache TTL:
# 1h on a Claude subscription inside plan usage, 5m otherwise.
KEEPWARM_INTERVAL_MIN=50

# Stop after this many bumps and let the cache go cold. 8 bumps ~= 8 hours.
KEEPWARM_MAX_BUMPS=8

# Don't warm a session whose transcript is smaller than this: rebuilding a small
# cache is cheaper than paying a read every hour to preserve it.
KEEPWARM_MIN_TRANSCRIPT_KB=150

KEEPWARM_POLL_SEC=60
# KEEPWARM_DISABLE=1
